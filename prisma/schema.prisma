model NewbornRecord {
  id                 String          @id @default(uuid()) @db.Uuid
  deliverySummaryId  String          @map("delivery_summary_id") @db.Uuid
  birthOrder         Int             @default(1) @map("birth_order")
  sex                BabySex?
  birthWeightGrams   Int?            @map("birth_weight_grams")
  apgar1             Int?            @map("apgar_1")
  apgar5             Int?            @map("apgar_5")
  gaWeeks            Int?            @map("ga_weeks")
