  fetalHeartRate    Int?             @map("fetal_heart_rate")
  contractionsNote  String?          @map("contractions_note")
  systolic          Int?
  diastolic         Int?
  pulseRate         Int?             @map("pulse_rate")
  temperatureC      Decimal?         @map("temperature_c") @db.Decimal(4, 1)
  recordedById      String           @map("recorded_by_id") @db.Uuid
