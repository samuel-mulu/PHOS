  deliveredAt           DateTime?               @map("delivered_at")
  modeOfDelivery        DeliveryMode?           @map("mode_of_delivery")
  csIndication          String?                 @map("cs_indication")
  placeOfDelivery       DeliveryPlace?          @map("place_of_delivery")
  presentation          FetalPresentation?
