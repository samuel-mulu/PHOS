NODE_ENV=development
PORT=4001
# Local Postgres:
# DATABASE_URL=postgresql://phos:phos_dev_password@localhost:5432/phos?schema=public
# Neon (console.neon.tech → project → Connect → use "Direct connection" for dev/migrations):
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&schema=public
DATABASE_URL=postgresql://phos:phos_dev_password@localhost:5432/phos?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-random-characters
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL_DAYS=7
# Local dev: http://localhost:3000
# Production (Vercel): https://your-app.vercel.app — comma-separate preview + prod URLs if needed
CORS_ORIGINS=http://localhost:3000
# true on Render (HTTPS); false for local http://localhost
COOKIE_SECURE=false
SEED_ADMIN_EMAIL=admin@phos.local
SEED_ADMIN_PASSWORD=ChangeMe123!
